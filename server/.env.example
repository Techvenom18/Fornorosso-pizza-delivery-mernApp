# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pizzadelivery

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Nodemailer (Gmail example - use an App Password, not your real password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_ALERT_EMAIL=admin@example.com

# Razorpay (test mode keys from Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret

# Low stock threshold (units) - used by the node-cron job
LOW_STOCK_THRESHOLD=20